# LOTM Tarot App - Environment Configuration Example
# Copy to .env and configure values. NEVER commit .env to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Security & Sessions
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars-long

# Database Configuration (PostgreSQL + Psycopg 3 async)
DATABASE_URL=postgresql+psycopg://lotm_user:change_me_password@localhost:5432/lotm_tarot
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# CORS (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
